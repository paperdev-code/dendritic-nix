layout {
  default_tab_template {
    pane size=1 borderless=true {
      plugin location="zellij:tab-bar"
    }
    children
    pane size=1 borderless=true {
      plugin location="zellij:status-bar"
    }
  }

  tab name="info" focus=true {
    pane command="/bin/sh" {
      name "Fastfetch"
      args "-c" "fastfetch; exec sleep infinity"
    }
  }

  tab name="system" {
    pane command="btop" {
      name "System"
      size "100%"
    }
  }
}
