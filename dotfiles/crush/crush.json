{
  "$schema": "https://charm.land/crush.json",
  "options": {
    "disable_metrics": true,
    "disable_provider_auto_update": true
  },
  "models": {
    "large": {
      "model": "gemma-4",
      "provider": "llama-server-thinking"
    },
    "small": {
      "model": "gemma-4",
      "provider": "llama-server-fast"
    }
  },
  "providers": {
    "llama-server-thinking": {
      "name": "llama-server (thinking)",
      "base_url": "http://127.0.0.1:10110/v1",
      "type": "openai-compat",
      "models": [
        {
          "id": "gemma-4",
          "name": "Gemma 4 Thinking"
        }
      ],
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": true
        },
        "thinking_budget_tokens": 2048
      }
    },
    "llama-server-fast": {
      "name": "llama-server (fast)",
      "base_url": "http://127.0.0.1:10110/v1",
      "type": "openai-compat",
      "models": [
        {
          "id": "gemma-4",
          "name": "Gemma 4 Fast"
        }
      ],
      "extra_body": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      }
    }
  }
}
